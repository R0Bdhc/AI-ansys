# LLM 提供商选择：deepseek | kimi | claude | openai | local | custom
LLM_PROVIDER=deepseek

# 通用 LLM 配置（优先级高于旧版 DEEPSEEK_* / OPENAI_* 变量）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 旧版 DeepSeek 配置（保留向后兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI 配置（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── ANSYS 路径配置（全部可选；跨版本自动发现优先）──
# 留空时系统自动扫描标准安装位置（Windows 各盘符 Program Files / Linux /usr/ansys_inc 等）
# 并选择最新版本。多版本共存时可用以下变量显式指定。
#
# 显式指定可执行文件（最高优先级，跨平台通用）
# Windows 示例：D:/ANSYS Inc/v252/ANSYS/bin/winx64/MAPDL.exe
# Linux 示例：  /usr/ansys_inc/v252/ansys/bin/ansys252
MAPDL_EXECUTABLE=

# 目录级指定（按 discovery 链依次尝试）
ANSYS_DIR=
AWP_ROOT=
ANSYSLIC_DIR=

# 旧版版本号变量（兼容保留，新部署建议用上面的通用变量）
# ANSYS241_DIR=
# AWP_ROOT241=

# Mechanical 启动器（242+ 自动探测失败时手动指定）
# Windows 示例：C:/Program Files/ANSYS Inc/v242/aisol/bin/winx64/AnsysWBU.exe
# Linux 示例：  /usr/ansys_inc/v242/aisol/bin/wlx64/<启动器>
MECHANICAL_EXEC=

# 异步任务并发上限（默认 2）
# CAE_JOB_MAX_WORKERS=2
