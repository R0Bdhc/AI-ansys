# LLM 提供商选择：deepseek | kimi | claude | openai | local | custom
LLM_PROVIDER=deepseek

# 通用 LLM 配置（优先级高于旧版 DEEPSEEK_* / OPENAI_* 变量）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 旧版 DeepSeek 配置（保留向后兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI 配置（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ANSYS 路径配置
MAPDL_EXECUTABLE=
ANSYS_DIR=
AWP_ROOT=
ANSYS241_DIR=
ANSYSLIC_DIR=
AWP_ROOT241=

# Mechanical 可执行文件路径（可选，用于 242+ 版本自动探测失败时手动指定）
# 示例：C:/Program Files/ANSYS Inc/v242/aisol/bin/win64/AnsysWBU.exe
MECHANICAL_EXEC=
